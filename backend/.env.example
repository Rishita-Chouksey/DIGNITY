# DIGNITY Backend Environment Variables Template
DATABASE_URL=postgresql+psycopg://dignity:dignity@127.0.0.1:5433/dignity
ADMIN_TOKEN=change-me-for-demo

# Semantic search & pgvector embeddings (true enables local sentence-transformers)
EMBEDDINGS_ENABLED=true

# Extractor provider: 'none' for offline rule-based extraction, or 'openai'
LLM_PROVIDER=none
# OPENAI_API_KEY=sk-...
